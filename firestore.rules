rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated (anonymous or verified)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check user owns the document by matching Firebase UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: only the owner can read, write, or delete their profile
    match /users/{userId} {
      allow read, write, delete: if isOwner(userId);

      // User subcollections (likes, playlists, recentlyPlayed, preferences)
      match /likes/{trackId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /playlists/{playlistId} {
        allow read, write, delete: if isOwner(userId);

        match /tracks/{trackItem} {
          allow read, write, delete: if isOwner(userId);
        }
      }

      match /recentlyPlayed/{entryId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /preferences/{prefId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Public catalog collections: read-only for authenticated clients, no direct writes
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if false;
    }

    match /artists/{artistId} {
      allow read: if true;
      allow write: if false;
    }

    match /albums/{albumId} {
      allow read: if true;
      allow write: if false;
    }

    // Pseudonymous interaction events: append-only for authenticated users
    match /events/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
